{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*.{png,jpg,jpeg,gif,webp,svg}",
      "/favicon.ico",
      "/favicon.svg",
      "/favicon-96x96.png",
      "/apple-touch-icon.png",
      "/site.webmanifest",
      "/pitch-deck.html",
      "/bbb-nuke-hero.html"
    ]
  },
  "routes": [
    {
      "route": "/pitch-deck.html",
      "rewrite": "/pitch-deck.html"
    },
    {
      "route": "/bbb-nuke-hero.html",
      "rewrite": "/bbb-nuke-hero.html"
    },
    {
      "route": "/check-in",
      "rewrite": "/check-in/index.html"
    }
  ],
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
